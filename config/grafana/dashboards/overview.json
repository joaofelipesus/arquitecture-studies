      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(rails_request_duration_seconds_sum[$__range])) / sum(rate(rails_request_duration_seconds_count[$__range]))",
          "legendFormat": ""
