      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "topk(5, sum by (span_name) (rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{span_name}}"
