{
  "uid": "apm",
  "title": "APM",
  "tags": [
    "rails",
    "apm",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "New Relic-style APM view built from Tempo's span metrics (OpenTelemetry traces).",
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"books-library\", span_kind=\"SPAN_KIND_SERVER\"}, span_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"books-library\", span_kind=\"SPAN_KIND_SERVER\"}, span_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=\"books-library\"}, service_instance_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=\"books-library\"}, service_instance_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/overview",
      "keepTime": true,
      "icon": "dashboard"
    },
    {
      "title": "Request traces",
      "type": "link",
      "url": "/d/traces",
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary (selected range)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Avg response time",
      "type": "stat",
      "description": "Average duration of the web transactions (server spans).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum (rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])) / sum (rate(traces_spanmetrics_latency_count{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "p95 response time",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Throughput",
      "type": "stat",
      "description": "Requests per minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])) * 60",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Error rate",
      "type": "stat",
      "description": "Share of requests that ended with a 5xx (spans with error status). 4xx are not errors, like New Relic's default.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum by () (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__range])) / sum by () (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range]))) or (0 * sum by () (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Apdex (T = 0.5s)",
      "type": "stat",
      "description": "(satisfied <= 0.5s + tolerating <= 2s / 2) / total.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(traces_spanmetrics_latency_bucket{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\", le=\"0.5\"}[$__range])) + sum(rate(traces_spanmetrics_latency_bucket{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\", le=\"2\"}[$__range]))) / 2 / sum(rate(traces_spanmetrics_latency_count{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.94
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Time in database",
      "type": "stat",
      "description": "Share of the response time spent waiting on SQL queries (all routes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_CLIENT\"}[$__range])) / sum(rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Web transactions",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 9,
      "title": "Web transactions time (avg per request, all routes)",
      "type": "timeseries",
      "description": "Like New Relic's breakdown: the time per request spent in SQL queries, and the rest of the request time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) - sum(rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval]))) / sum(rate(traces_spanmetrics_latency_count{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "Ruby (app code, views, middleware)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_CLIENT\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_latency_count{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "Database (PostgreSQL)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum (rate(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])) / sum (rate(traces_spanmetrics_latency_count{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "Response time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 30,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Response time"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
