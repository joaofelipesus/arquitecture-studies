          },
          "refId": "A",
          "expr": "(sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__rate_interval]))) or (0 * sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__rate_interval])))",
