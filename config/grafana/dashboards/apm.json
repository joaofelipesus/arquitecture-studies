    {
      "id": 13,
      "title": "Top 5 transactions by time consumed",
      "type": "timeseries",
      "description": "Total time spent serving each route per second (requests per second x avg duration): where the app's capacity goes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
