    {
      "id": 15,
      "title": "Transactions",
      "type": "table",
      "description": "Selected range. Click a transaction to see its traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (span_name) (increase(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])) / scalar(sum(increase(traces_spanmetrics_latency_sum{service=\"books-library\", service_instance_id=~\"$instance\", span_kind=\"SPAN_KIND_SERVER\", span_name=~\"${route:regex}\"}[$__range])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
