FROM ruby:3.4.6

WORKDIR /usr/src/app

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y postgresql-client libvips && \
    rm -rf /var/lib/apt/lists/*

# gems path (persisted through the gems volume in docker-compose.yml)
ENV BUNDLE_PATH=/gems

# copy Gemfile to container
COPY Gemfile Gemfile.lock ./

# copy application dir to container
COPY . .

EXPOSE 3000
